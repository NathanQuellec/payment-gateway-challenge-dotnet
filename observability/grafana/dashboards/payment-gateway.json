{
  "uid": "payment-gateway",
  "title": "Payment gateway",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "payments",
    "opentelemetry"
  ],
  "editable": false,
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Live local observability",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "The API exports every 5 seconds and Prometheus scrapes every 5 seconds. Send payment requests to see outcomes and latency. Rates need at least two scrapes. Counters are totals for currently observed API processes; restarts reset them. This dashboard shows metrics; trace summaries remain in collector logs."
      }
    },
    {
      "id": 2,
      "title": "Collector scrape healthy (1 = up)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "payment-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"payment-gateway\"}",
          "legendFormat": "Collector",
          "datasource": {
            "type": "prometheus",
            "uid": "payment-prometheus"
          },
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "title": "Payments by outcome (process totals)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "payment-prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 3,
        "w": 12,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (payments_processed_total)",
          "legendFormat": "{{outcome}}",
          "datasource": {
            "type": "prometheus",
            "uid": "payment-prometheus"
          },
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "title": "Rate limit rejections (process totals)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "payment-prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(payments_rate_limit_rejections_total)) or vector(0)",
          "legendFormat": "Rejected",
          "datasource": {
            "type": "prometheus",
            "uid": "payment-prometheus"
          },
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
