      }
    },
    {
      "id": 5,
      "title": "Payment outcomes per second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "payment-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(payments_processed_total[2m]))",
          "legendFormat": "{{outcome}}",
          "datasource": {
            "type": "prometheus",
            "uid": "payment-prometheus"
          },
          "instant": false,
          "range": true
